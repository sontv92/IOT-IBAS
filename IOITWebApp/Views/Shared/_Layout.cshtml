    <script>

        $(document).ready(function () {
            $("#cart").load("/ShoppingCart/LoadCart");
        });

        function RemoveFromCart(id) {
            $.ajax({
                url: '/ShoppingCart/RemoveFromCart?id=' + id,
                contentType: 'application/html; charset=utf-8',
                type: 'POST',
                dataType: 'html'
            })
                .success(function (result) {
                    //console.log(result);
                    $('#cart').html(result);
                    element.classList.toggle("mystyle");
                    element1.style.display = "block";
                    var msgSuccess = '<div class="alert alert-success alert-dismissible" role="alert"><button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button><strong></strong> Xoa trong giỏ hàng thành công!</div>';
                    $('#formSubmitted').append(msgSuccess);
                })
                .error(function (xhr, status) {
                    var msgSuccess = '<div class="alert alert-success alert-dismissible" role="alert"><button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button><strong></strong> Xoa trong giỏ hàng that bai!</div>';
                    $('#formSubmitted').append(msgSuccess);
                });
        }

    </script>

